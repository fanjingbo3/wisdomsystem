# ==============================================
# 智扫通 · 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ==============================================

# 阿里云百炼 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# LangSmith API Key（用于调试追踪）
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING_V2=true
LANGSMITH_PROJECT=wisdomsystem-debug

# Redis 配置（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 开发模式
DEBUG=false
